# docker compose için yapılandırma. `./deploy/init-env.sh` bunu rastgele sırlarla `.env` olarak üretir.
# .env gitignore'dadır; JWT_*, SECRETS_ENCRYPTION_KEY ve POSTGRES_PASSWORD'ü güvenli yerde YEDEKLE
# (SECRETS_ENCRYPTION_KEY kaybolursa saklı pull secret'lar çözülemez).

# --- PostgreSQL ---
POSTGRES_USER=healthbeat
POSTGRES_DB=healthbeat
# URL'de kullanıldığı için özel karakter içermesin (hex/alfanümerik): openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Server sırları ---
# En az 32 bayt ve birbirinden farklı: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=CHANGE_ME

# --- İlk süper admin (yalnızca hiç süper admin yokken; ilk girişte şifre değiştirilir, sonra silinebilir) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Ağ ---
# Sunucunun agent'lara sunduğu kendinden imzalı sertifika bu adresler için üretilir (virgülle ayrılmış DNS/IP).
# Agent'lar server'a hangi adresle bağlanacaksa onu ekle, ör. localhost,server,monitor.example.com,10.0.0.5
HB_TLS_HOSTS=localhost,server
HB_PANEL_PORT=8080
HB_API_PORT=8443
# Yalnızca yerelden erişim için 127.0.0.1 yap (ör. önüne reverse proxy koyarken)
HB_PANEL_BIND=0.0.0.0
HB_API_BIND=0.0.0.0

# --- İsteğe bağlı (boş = server varsayılanı) ---
# Panel ile API ayrı alan adlarındaysa: API_PROXY_URL= (boş) yap, API_BASE_URL ve CORS_ALLOWED_ORIGINS ver.
# API_BASE_URL=
# API_PROXY_URL=
# CORS_ALLOWED_ORIGINS=
# Pull agent sertifikalarını doğrulayacak CA: dosyayı certs volume'üne ca.pem olarak koy ve şunu aç
# PULL_CA_CERT_FILE=/certs/ca.pem
# METRICS_RETENTION_DAYS=30
# Agent sürüm politikası (yalnızca panelde bilgilendirir; bkz. docs/COMPATIBILITY.md).
# LATEST_AGENT_VERSION=
# MIN_SUPPORTED_AGENT_VERSION=
# AUTO_MIGRATE=true
# --- E-posta (alert e-postaları ve "Şifremi unuttum") ---
# Şifre sıfırlama için SMTP_HOST ve PANEL_BASE_URL İKİSİ DE gerekli; biri yoksa özellik kapalıdır ve giriş sayfası
# bunu söyler. PANEL_BASE_URL kullanıcının tarayıcıda gördüğü panel adresidir (e-postadaki bağlantının kökü),
# ör. https://panel.example.com — isteğin Host başlığından türetilmez.
# Geliştirmede gerçek SMTP yerine: docker compose --profile mail up -d  (gelen kutusu: http://localhost:8025)
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_FROM=healthbeat@localhost  PANEL_BASE_URL=http://localhost:8080
# PANEL_BASE_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- İmaj kaynağı (isteğe bağlı; boşsa yerelde derlenen imajlar kullanılır) ---
# Yayınlanmış bir sürümü kullanmak için: HB_REGISTRY=ghcr.io/<sahip>   HB_VERSION=1.2.0
# Ardından: docker compose pull && docker compose up -d   (güncellemeden önce veritabanı yedeği al: docs/DISTRIBUTION.md)
# HB_REGISTRY=
# HB_VERSION=
